# Copie este arquivo para ".env.local" e preencha com as chaves do seu projeto Firebase
# (Firebase Console > Configurações do projeto > Seus apps > SDK setup and configuration).
# Sem essas variáveis, o app funciona normalmente salvando os dados no localStorage do navegador
# (cada pessoa vê só os próprios dados, e eles não são compartilhados nem sincronizados).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
